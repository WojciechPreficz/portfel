# Set real values in the hosting provider's environment; do not commit secrets.
PORTFEL_ENV=production
PORTFEL_AUTH_DISABLED=false

# Generate with: python scripts/hash_password.py
PORTFEL_PASSWORD_HASH=
PORTFEL_SECRET_KEY=

PORTFEL_SESSION_HOURS=12
PORTFEL_COOKIE_SECURE=true

# Leave empty when the frontend and API use the same domain.
# Otherwise, list allowed frontend origins separated by commas.
PORTFEL_CORS_ORIGINS=

# Defaults to data/portfel.db relative to the repository root.
# Absolute paths are supported; ensure the hosting account can write to the directory.
PORTFEL_DATABASE_PATH=data/portfel.db

# Optional: defaults to backend/frontend_dist relative to the repository root.
PORTFEL_FRONTEND_DIR=backend/frontend_dist

# Set to false if the hosting provider does not allow background scheduling.
PORTFEL_SCHEDULER_ENABLED=true
